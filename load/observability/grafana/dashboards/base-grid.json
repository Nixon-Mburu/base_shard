        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by(le)(rate(load_response_seconds_bucket{run_id=~\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(load_response_seconds_bucket{run_id=~\"$run_id\"}[$__rate_interval])))",
