        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(method,route)(rate(load_requests_total{run_id=~\"$run_id\"}[$__rate_interval]))",
